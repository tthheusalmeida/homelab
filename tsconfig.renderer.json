{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {
      "#components/*": ["./renderer/src/components/*.tsx"],
      "#ui/*": ["./renderer/src/ui/*.tsx"],
      "#lib/*": ["./renderer/src/lib/*.ts"],
      "#hooks/*": ["./renderer/src/hooks/*.ts"],
      "#test/*": ["./renderer/src/test/*"],
      "#shared/*": ["./src/shared/*"]
    }
  },
  "include": ["renderer/**/*.ts", "renderer/**/*.tsx", "src/shared/**/*.ts"],
  "exclude": ["renderer/vite-aliases.mts", "src/**/*.spec.ts", "src/**/testing/**"]
}
