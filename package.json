{
  "name": "homelab-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "HomeLab desktop (Electron)",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "build:back": "npm --prefix ../back run build",
    "build:front": "npm --prefix ../front run build",
    "build:main": "tsc -p tsconfig.build.json",
    "build": "npm run build:back && npm run build:front && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "npm run build:back && npm run build:main && concurrently -k -n front,app \"npm --prefix ../front run dev\" \"wait-on tcp:5173 && cross-env HOMELAB_FRONT_URL=http://localhost:5173 electron .\"",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "wait-on": "^9.5.1"
  }
}
