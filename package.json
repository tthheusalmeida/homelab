{
  "name": "homelab-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "HomeLab desktop (Electron)",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.build.json && npm run build:preload",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && concurrently -k -n main,settings,app \"node ../front/node_modules/vite/bin/vite.js --config vite.renderer.main.config.mts\" \"node ../front/node_modules/vite/bin/vite.js --config vite.renderer.settings.config.mts\" \"wait-on tcp:5173 tcp:5174 && cross-env HOMELAB_FRONT_URL=http://localhost:5173 HOMELAB_SETTINGS_URL=http://localhost:5174 electron .\"",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer:main": "node ../front/node_modules/vite/bin/vite.js build --config vite.renderer.main.config.mts",
    "build:renderer:settings": "node ../front/node_modules/vite/bin/vite.js build --config vite.renderer.settings.config.mts",
    "build:renderer": "npm run build:renderer:main && npm run build:renderer:settings",
    "test:renderer": "node ../front/node_modules/vitest/vitest.mjs run --config vitest.renderer.config.mts",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "overrides:check": "npm run build:main && node dist/overrides/cli.js check",
    "overrides:update": "npm run build:main && node dist/overrides/cli.js update"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "axios": "^1.21.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "yaml": "^2.9.1"
  }
}
