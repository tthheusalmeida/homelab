{
  "name": "homelab-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "HomeLab desktop (Electron)",
  "license": "MIT",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.build.json && npm run build:preload",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && concurrently -k -n app \"vite --config vite.renderer.main.config.mts\" \"wait-on tcp:5173 && cross-env HOMELAB_FRONT_URL=http://localhost:5173 electron .\"",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer:main": "vite build --config vite.renderer.main.config.mts",
    "build:renderer": "npm run build:renderer:main",
    "test:renderer": "vitest run --config vitest.renderer.config.mts",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/build-fonts-css.mjs",
    "dist": "npm run dist:win",
    "dist:dir": "npm run icons && npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run icons && npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "prepare": "husky",
    "test:commitlint": "node --test scripts/commitlint.test.mjs",
    "test:release": "node --test scripts/release/release.test.mjs scripts/bin-utils.test.mjs scripts/changed-checks.test.mjs",
    "check:changed": "node scripts/changed-checks.mjs",
    "check:all": "npm run lint && npm run typecheck:renderer && npm test && npm run test:renderer",
    "bin:pack": "node scripts/bin-pack.mjs",
    "bin:fetch": "node scripts/bin-fetch.mjs"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.34.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@google/genai": "^2.32.0",
    "@napi-rs/canvas": "^1.2.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "axios": "^1.21.1",
    "electron-updater": "^6.8.11",
    "groq-sdk": "^1.6.0",
    "html-to-image": "^1.11.13",
    "pdfjs-dist": "^6.5.438",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^6.0.1",
    "uuidv7": "^1.2.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "author": "HomeLab"
}
